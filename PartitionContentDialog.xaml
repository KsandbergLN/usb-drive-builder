<Window x:Class="LaptopQaUsbBuilder.PartitionContentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add partition content" Width="620" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1"/>
        <SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA"/>
        <SolidColorBrush x:Key="ThemeText" Color="#17272D"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970"/>
        <SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7"/>
        <SolidColorBrush x:Key="ThemeShellStroke" Color="#E0E5E2"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#687F87"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeShellStroke}"
            BorderThickness="1" CornerRadius="22" Padding="1">
        <Border.Effect><DropShadowEffect Color="#263A42" BlurRadius="22" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Margin="24,9,14,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Add partition content" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource ThemeMuted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="×" Click="Close_Click" Foreground="{DynamicResource ThemeText}"
                        Background="Transparent" FontSize="22" FontWeight="Normal" Width="38" Padding="2"/>
            </Grid>

            <Border x:Name="ContentPanel" Grid.Row="1" Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}"
                    BorderThickness="1" CornerRadius="16" Margin="20,8,20,0" Padding="18">
                <StackPanel>
                    <UniformGrid x:Name="StandardButtons" Columns="3">
                        <Button x:Name="FilesButton" Content="Files / folders" Click="Files_Click" Margin="0,0,7,0" ToolTip="Manage files and folders to copy into the partition root"/>
                        <Button x:Name="FolderButton" Visibility="Collapsed" Content="Folder" Click="Folder_Click"/>
                        <Button x:Name="XmlButton" Content="XML" Click="Xml_Click" Margin="0,0,7,0" ToolTip="Select Autounattend.xml"/>
                        <Button x:Name="IsoButton" Content="ISO" Click="Iso_Click" ToolTip="Select and prepare a Windows ISO"/>
                    </UniformGrid>

                    <StackPanel x:Name="IsoExtrasSection">
                        <TextBlock Text="Windows ISO content" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,2"/>
                        <TextBlock Foreground="{DynamicResource ThemeMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9">
                            <Run Text="Drivers are injected into Windows. Scripts and supporting files run before OOBE."/><LineBreak/>
                            <Run Text="Generate an XML from the Windows Setup defaults in Config when needed."/>
                        </TextBlock>
                        <CheckBox x:Name="GenerateAutounattendCheckBox" Content="Generate Autounattend.xml" Margin="0,0,0,10"
                                  Checked="GenerateAutounattend_Checked" Unchecked="GenerateAutounattend_Unchecked"
                                  ToolTip="Create a new Autounattend.xml using the Generated Windows Setup defaults in Config."/>
                        <UniformGrid Columns="2">
                            <Button x:Name="DriversButton" Content="Drivers" Click="Drivers_Click" Margin="0,0,7,0"
                                    ToolTip="Select drivers now; they will be injected after a Windows ISO is added"/>
                            <Button x:Name="ScriptsButton" Content="Scripts" Click="ScriptFiles_Click" Margin="7,0,0,0"
                                    ToolTip="Select scripts now; they will run after a Windows ISO is added"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Row="2" Content="Close" Click="Close_Click" HorizontalAlignment="Right"
                    Margin="20,16,20,20" Padding="22,9"/>
        </Grid>
    </Border>
</Window>
