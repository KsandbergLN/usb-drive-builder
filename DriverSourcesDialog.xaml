<Window x:Class="LaptopQaUsbBuilder.DriverSourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Drivers" Width="690" Height="500" MinWidth="620" MinHeight="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1"/><SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA"/><SolidColorBrush x:Key="ThemeText" Color="#17272D"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970"/><SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7"/>
        <SolidColorBrush x:Key="ThemeShellStroke" Color="#E0E5E2"/><SolidColorBrush x:Key="WarningBackground" Color="#FBE8E7"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#E6A7A8"/><SolidColorBrush x:Key="WarningText" Color="#8E292F"/>
        <SolidColorBrush x:Key="DriveSelectedBorder" Color="#20B86A"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#687F87"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeShellStroke}" BorderThickness="1" CornerRadius="22">
        <Border.Effect><DropShadowEffect Color="#263A42" BlurRadius="22" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
        <Grid Margin="24,18">
            <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Windows Drivers" FontSize="26" FontWeight="Light"/><TextBlock Text="Add folders or individual INF packages" Foreground="{DynamicResource ThemeMuted}" FontSize="12"/></StackPanel>
                <Button Grid.Column="1" Content="×" Click="Cancel_Click" Foreground="{DynamicResource ThemeText}" Background="Transparent" FontSize="21" Padding="3" VerticalAlignment="Top"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                <Button Content="Add Folder" Click="AddFolder_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Add INF Files" Click="AddFiles_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Remove" Click="Remove_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="Clear_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="14" Padding="8">
                <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeText}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource DriveSelectedBorder}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border x:Name="UnsignedWarning" Grid.Row="3" Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="Allow unsigned drivers is enabled in Config. DISM will use /ForceUnsigned, but Windows or Secure Boot may still refuse a package." Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontSize="11"/>
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <TextBlock Text="Folders are scanned recursively. Individual selections must be INF files." Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Save" Click="Save_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
