<Window x:Class="LaptopQaUsbBuilder.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Drive Builder" Width="540" SizeToContent="Height"
        MinWidth="440" MaxWidth="700" MaxHeight="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1"/>
        <SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA"/>
        <SolidColorBrush x:Key="ThemeText" Color="#17272D"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970"/>
        <SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7"/>
        <SolidColorBrush x:Key="ThemeShellStroke" Color="#E0E5E2"/>
        <SolidColorBrush x:Key="ThemeSelection" Color="#C9F1DD"/>
        <SolidColorBrush x:Key="ReadyBackground" Color="#D7F3E5"/>
        <SolidColorBrush x:Key="ReadyBorder" Color="#74D3A2"/>
        <SolidColorBrush x:Key="ReadyText" Color="#147A4B"/>
        <SolidColorBrush x:Key="WarningBackground" Color="#FBE8E7"/>
        <SolidColorBrush x:Key="WarningBorder" Color="#E6A7A8"/>
        <SolidColorBrush x:Key="WarningText" Color="#8E292F"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#687F87"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.72"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="10,7">
                    <ContentPresenter TextElement.Foreground="{DynamicResource ThemeText}"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeShellStroke}"
            BorderThickness="1" CornerRadius="22" Padding="1">
        <Border.Effect><DropShadowEffect Color="#263A42" BlurRadius="22" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Margin="22,8,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="×" Click="Close_Click" Foreground="{DynamicResource ThemeText}" Background="Transparent"
                        FontSize="22" FontWeight="Normal" Width="38" MinWidth="0" Padding="2" ToolTip="Close"/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}"
                    BorderThickness="1" CornerRadius="16" Margin="20,8,20,0" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource ReadyBackground}" BorderBrush="{DynamicResource ReadyBorder}" BorderThickness="1">
                        <TextBlock x:Name="IconText" Text="i" Foreground="{DynamicResource ReadyText}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ScrollViewer Grid.Column="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="MessageText" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource ThemeText}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,20"/>
        </Grid>
    </Border>
</Window>
