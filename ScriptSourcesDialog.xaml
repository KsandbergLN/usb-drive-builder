<Window x:Class="LaptopQaUsbBuilder.ScriptSourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Setup Scripts" Width="650" Height="460" MinWidth="580" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1"/><SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA"/><SolidColorBrush x:Key="ThemeText" Color="#17272D"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970"/><SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7"/>
        <SolidColorBrush x:Key="ThemeShellStroke" Color="#E0E5E2"/><SolidColorBrush x:Key="DriveSelectedBorder" Color="#20B86A"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#687F87"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeShellStroke}" BorderThickness="1" CornerRadius="22">
        <Border.Effect><DropShadowEffect Color="#263A42" BlurRadius="22" ShadowDepth="8" Opacity="0.35"/></Border.Effect>
        <Grid Margin="24,18">
            <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Windows Setup Scripts" FontSize="26" FontWeight="Light"/><TextBlock Text="Add scripts and supporting files from multiple locations" Foreground="{DynamicResource ThemeMuted}" FontSize="12"/></StackPanel>
                <Button Grid.Column="1" Content="×" Click="Close_Click" Foreground="{DynamicResource ThemeText}" Background="Transparent" FontSize="21" Padding="3" VerticalAlignment="Top"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
                <Button Content="Add Files" Click="AddFiles_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Add Folder" Click="AddFolder_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Remove" Click="Remove_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="Clear_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="14" Padding="8">
                <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeText}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="6,5"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="File" Foreground="{DynamicResource DriveSelectedBorder}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <TextBlock Text="Executable script types run in listed order. Other file types remain available as supporting files." Foreground="{DynamicResource ThemeMuted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Close" Click="Close_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
