<Window x:Class="LaptopQaUsbBuilder.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save profile as" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#687F87"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="90"/><Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="22" Padding="24">
        <StackPanel>
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,16">
                <TextBlock x:Name="DialogTitleText" FontSize="22"/>
                <Button Content="×" Click="Cancel_Click" HorizontalAlignment="Right" MinWidth="28" Padding="0" Background="Transparent" Foreground="{DynamicResource ThemeText}" FontSize="22"/>
            </Grid>
            <TextBlock Text="Profile name" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox" Height="36" MaxLength="80" Padding="8,4" VerticalContentAlignment="Center"
                     Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeStroke}"
                     TextChanged="NameTextBox_TextChanged"/>
            <TextBlock x:Name="ValidationText" Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" IsDefault="True" Click="Save_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
