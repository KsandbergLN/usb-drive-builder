<Window x:Class="LaptopQaUsbBuilder.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaptopQaUsbBuilder"
        Title="Configuration" Width="820" Height="660" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}">
    <Window.Resources>
        <local:SizeEntryValidConverter x:Key="SizeEntryValidConverter"/>
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1"/>
        <SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB"/>
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA"/>
        <SolidColorBrush x:Key="ThemeText" Color="#17272D"/>
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970"/>
        <SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7"/>
        <SolidColorBrush x:Key="ThemeSelection" Color="#C9F1DD"/>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#687F87"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="100" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSelection}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="5">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="10,0,4,0" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{DynamicResource ThemeText}"/>
                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource ThemeMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="300" Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}"/>
        </Style>
        <Style x:Key="ConfigSizeDisplay" TargetType="TextBlock">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeEntryValidConverter}}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                    <Setter Property="ToolTip" Value="Enter a number followed by MB or GB, or enter * for remaining space."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConfigSizeEditor" TargetType="TextBox">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeEntryValidConverter}}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" Value="Enter a number followed by MB or GB, or enter * for remaining space."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Placement" Value="Mouse"/><Setter Property="HorizontalOffset" Value="12"/><Setter Property="VerticalOffset" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                    <Border.Effect><DropShadowEffect Color="#52666D" BlurRadius="10" ShadowDepth="3" Opacity="0.22"/></Border.Effect>
                    <ContentPresenter TextElement.Foreground="{DynamicResource ThemeText}"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource ThemeShell}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="26">
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid Width="940" Height="760" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality">
        <Grid Margin="28,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                <StackPanel MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,18,0"><TextBlock x:Name="DialogTitleText" Text="Partition Settings" FontSize="28" FontWeight="Light"/><TextBlock x:Name="DialogSubtitleText" Text="Configure the MBR layout used for future builds." Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock x:Name="LanguageLabel" Text="Language" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <ComboBox x:Name="LanguagePicker" Height="36" SelectionChanged="LanguagePicker_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock x:Name="ThemeLabel" Text="Theme" FontWeight="SemiBold" Margin="2,0,0,4"/>
                    <ComboBox x:Name="ThemePicker" Height="36" SelectionChanged="ThemePicker_SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="3" Content="x" Click="Cancel_Click" Foreground="{DynamicResource ThemeText}" Background="Transparent" FontSize="18" Padding="4" VerticalAlignment="Top"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="DefaultPartitionsLabel" Text="Default partitions" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="AddDefaultPartitionButton" Grid.Column="1" Content="+" Click="AddDefaultPartition_Click" Width="30" Height="30" Padding="0" FontSize="18" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,12,0" ToolTip="Add a default partition" IsEnabled="{Binding CanAddDefaultPartitions, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CircleButton}"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <TextBlock x:Name="RemainingHint" Grid.Column="2" Text="Sizes: 50 MB, 20 GB, or * for all remaining space; use * exactly once. Label limits: FAT32 11, exFAT 15, NTFS 32 characters." Foreground="{DynamicResource ThemeMuted}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button x:Name="DefaultsLockButton" Grid.Column="3" Content="&#xE72E;" Click="DefaultsLock_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="42" Height="36" Padding="8" Margin="12,0,0,0" ToolTip="Unlock default partition editing"/>
            </Grid>
            <ScrollViewer Grid.Row="2" MaxHeight="258" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid x:Name="DefaultPartitionArea" AllowDrop="True" PreviewMouseMove="DefaultPartitionArea_PreviewMouseMove" PreviewMouseLeftButtonUp="DefaultPartitionArea_PreviewMouseLeftButtonUp" DragOver="PartitionGrid_DragOver" DragLeave="PartitionGrid_DragLeave" Drop="PartitionGrid_Drop"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                    <ItemsControl x:Name="RemoveButtonsList" Margin="0,28,0,0" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Height="42">
                            <Button Content="−" Click="RemoveDefaultPartitionRow_Click" Width="28" Height="28" Padding="0" FontSize="18" ToolTip="Remove this default partition"
                                    IsEnabled="{Binding CanRemoveDefaultPartitions, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CircleButton}"><Setter Property="Background" Value="{DynamicResource ClearButtonBackground}"/><Setter Property="Foreground" Value="{DynamicResource ClearButtonForeground}"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#87979D"/><Setter Property="Foreground" Value="#DDE4E6"/><Setter Property="Opacity" Value="0.6"/></Trigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                <DataGrid x:Name="PartitionGrid" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" HeadersVisibility="Column" ColumnHeaderHeight="28" GridLinesVisibility="Horizontal" RowHeaderWidth="0" VerticalAlignment="Top"
                          Background="{DynamicResource ThemeCard}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeStroke}" HorizontalGridLinesBrush="{DynamicResource ThemeStroke}" RowBackground="{DynamicResource ThemeInput}" FontSize="14" RowHeight="42">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="38"/>
                        <DataGridTextColumn x:Name="VolumeLabelColumn" Header="Volume label" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn x:Name="SizeColumn" Header="Size (MB, GB, or *)" Binding="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource ConfigSizeDisplay}" EditingElementStyle="{StaticResource ConfigSizeEditor}" Width="210"/>
                        <DataGridComboBoxColumn x:Name="FormatColumn" Header="Format" SelectedItemBinding="{Binding FileSystem, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                    <ItemsControl x:Name="ReorderHandlesList" Grid.Column="2" Margin="0,28,0,0" VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate><DataTemplate><Grid Height="42">
                            <Border Background="Transparent" Width="26" Height="34" Padding="4" Cursor="SizeNS" ToolTip="Drag to reorder" IsEnabled="{Binding DefaultsEditable, RelativeSource={RelativeSource AncestorType=Window}}" MouseLeftButtonDown="DefaultPartitionDragHandle_MouseLeftButtonDown"><Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><Rectangle Width="14" Height="2" RadiusX="1" Fill="{DynamicResource ThemeMuted}" Margin="0,0,0,4"/><Rectangle Width="14" Height="2" RadiusX="1" Fill="{DynamicResource ThemeMuted}"/></StackPanel></Border>
                        </Grid></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Margin="2,10,0,0">
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="460"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="GeneratedSetupPanel" Grid.RowSpan="2" Margin="0,0,16,0">
                        <TextBlock Text="Generated Windows Setup defaults" FontWeight="SemiBold"/>
                        <TextBlock Text="Used only when scripts are selected without a supplied Autounattend.xml. The generated file prepares the internal disk as GPT." Foreground="{DynamicResource ThemeMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,7"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Target disk"/><TextBox x:Name="TargetDiskTextBox" Width="55" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Install partition"/><TextBox x:Name="InstallPartitionTextBox" Width="75" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="EFI MB"/><TextBox x:Name="EfiSizeTextBox" Width="70" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="MSR MB"/><TextBox x:Name="MsrSizeTextBox" Width="65" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Shrink MB"/><TextBox x:Name="WindowsShrinkTextBox" Width="75" Height="28"/></StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="EFI label"/><TextBox x:Name="EfiLabelTextBox" Width="95" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Windows label"/><TextBox x:Name="WindowsLabelTextBox" Width="105" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Recovery label"/><TextBox x:Name="RecoveryLabelTextBox" Width="105" Height="28"/></StackPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Letters (EFI / Win / Rec)"/><TextBox x:Name="EfiLetterTextBox" Width="34" Height="28"/><TextBox x:Name="WindowsLetterTextBox" Width="34" Height="28" Margin="38,-28,0,0"/><TextBox x:Name="RecoveryLetterTextBox" Width="34" Height="28" Margin="76,-28,0,0"/></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel x:Name="GeneratedSetupOptionsPanel" Grid.Column="1">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,5"><TextBlock Text="Edition"/><ComboBox x:Name="EditionPicker" Width="178" Height="28" ToolTip="Choose the Windows image name to install. It must be included in the selected ISO."/></StackPanel>
                            <CheckBox x:Name="PromptBeforeInstallCheckBox" Content="Prompt before erasing/installing" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,0"><TextBlock Text="OOBE language"/><ComboBox x:Name="OobeLanguagePicker" Width="178" Height="28" ToolTip="Choose the Windows language and regional locale used during OOBE."/></StackPanel>
                            <StackPanel><TextBlock Text="OOBE keyboard"/><ComboBox x:Name="OobeKeyboardPicker" Width="178" Height="28" ToolTip="Choose the Windows keyboard layout used during OOBE."/></StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <Button x:Name="GenerateAutounattendButton" Grid.Column="1" Grid.Row="1" Content="Generate Autounattend.xml" Click="GenerateAutounattend_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" MinWidth="210" Height="36" Margin="0,10,14,2" Padding="14,7" FontSize="13" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" ToolTip="Choose where to save a generated Autounattend.xml using these setup settings."/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Windows image compression" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ImageCompressionPicker" Height="32" ToolTip="Choose the size and preparation-speed balance for the final Windows installation image."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <CheckBox x:Name="ForceUnsignedDriversCheckBox" Content="Allow unsigned drivers (DISM /ForceUnsigned)" FontWeight="SemiBold"/>
                            <TextBlock Text="Only applies when driver injection is selected. Windows or Secure Boot may still refuse to load unsigned drivers." Foreground="{DynamicResource ThemeMuted}" FontSize="11" TextWrapping="Wrap" Margin="22,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="11,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Temporary build cache" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CacheSizeText" Text="Calculating cache size..." Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="ClearCacheButton" Grid.Column="1" Content="Clear Cache" Click="ClearCache_Click" Padding="13,7" Margin="14,0,0,0"
                                Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}"
                                ToolTip="Delete cached Windows media and temporary driver data. Logs and saved settings are kept."/>
                    </Grid>
                </Border>
            </StackPanel>
            <Grid Grid.Row="4" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" Margin="8,0"/>
                <Button x:Name="SaveButton" Grid.Column="2" Content="Save" Click="Save_Click" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="8,0,0,0"/>
            </Grid>
        </Grid>
        </Grid>
        </Viewbox>
    </Border>
</Window>
