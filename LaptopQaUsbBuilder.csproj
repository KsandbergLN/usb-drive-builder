<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AppVersion>2.0.45</AppVersion>
    <AssemblyName>USB Drive Builder v$(AppVersion)</AssemblyName>
    <RootNamespace>LaptopQaUsbBuilder</RootNamespace>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>2.0.45.0</AssemblyVersion>
    <FileVersion>2.0.45.0</FileVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/LaptopQaUsbBuilder</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app-icon.ico" />
  </ItemGroup>
</Project>
