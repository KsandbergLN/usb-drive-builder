<Window x:Class="LaptopQaUsbBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaptopQaUsbBuilder"
        Title="USB Drive Builder" Width="1360" Height="820"
        Icon="Assets/app-icon.ico"
        MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" Foreground="{DynamicResource ThemeText}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
    <Window.Resources>
        <local:SizeEntryValidConverter x:Key="SizeEntryValidConverter"/>
        <SolidColorBrush x:Key="Slate" Color="#687F87" />
        <SolidColorBrush x:Key="ThemeShell" Color="#F4F5F1" />
        <SolidColorBrush x:Key="ThemeCard" Color="#FCFDFB" />
        <SolidColorBrush x:Key="ThemeInput" Color="#FBFCFA" />
        <SolidColorBrush x:Key="ThemeText" Color="#17272D" />
        <SolidColorBrush x:Key="ThemeMuted" Color="#526970" />
        <SolidColorBrush x:Key="ThemeStroke" Color="#9BB0B7" />
        <SolidColorBrush x:Key="ThemeShellStroke" Color="#E0E5E2" />
        <SolidColorBrush x:Key="ReadyBackground" Color="#D7F3E5" />
        <SolidColorBrush x:Key="ReadyBorder" Color="#74D3A2" />
        <SolidColorBrush x:Key="ReadyText" Color="#147A4B" />
        <SolidColorBrush x:Key="WarningBackground" Color="#FBE8E7" />
        <SolidColorBrush x:Key="WarningBorder" Color="#E6A7A8" />
        <SolidColorBrush x:Key="WarningText" Color="#8E292F" />
        <SolidColorBrush x:Key="DriveCardBackground" Color="#EFF3F1" />
        <SolidColorBrush x:Key="DriveCardBorder" Color="#A9BABF" />
        <SolidColorBrush x:Key="DriveSelectedBackground" Color="#D7F3E5" />
        <SolidColorBrush x:Key="DriveSelectedBorder" Color="#20B86A" />
        <SolidColorBrush x:Key="DriveText" Color="#17272D" />
        <SolidColorBrush x:Key="DriveMutedText" Color="#526970" />
        <SolidColorBrush x:Key="DriveHoverBorder" Color="#526970" />
        <SolidColorBrush x:Key="AddButtonBackground" Color="#D7F3E5" />
        <SolidColorBrush x:Key="AddButtonForeground" Color="#147A4B" />
        <SolidColorBrush x:Key="ClearButtonBackground" Color="#D8A2A3" />
        <SolidColorBrush x:Key="ClearButtonForeground" Color="#8E292F" />
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Slate}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="100" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInput}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SizeField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource SizeEntryValidConverter}}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource WarningBackground}"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarningText}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ToolTip" Value="Enter a number followed by MB or GB, or enter * for remaining space."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCard}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeStroke}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="26"/><Setter Property="Padding" Value="24,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#52666D" BlurRadius="16" ShadowDepth="6" Opacity="0.23"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ThemeMuted}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Placement" Value="Mouse"/><Setter Property="HorizontalOffset" Value="12"/><Setter Property="VerticalOffset" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
                <Border Background="{DynamicResource ThemeCard}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                    <Border.Effect><DropShadowEffect Color="#52666D" BlurRadius="10" ShadowDepth="3" Opacity="0.22"/></Border.Effect>
                    <ContentPresenter TextElement.Foreground="{DynamicResource ThemeText}"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainShell" Background="{DynamicResource ThemeShell}" CornerRadius="28" BorderBrush="{DynamicResource ThemeShellStroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Grid.Row="0" Margin="28,18,28,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConfigButton" Content="&#x2630;" Click="Config_Click" FontSize="23" FontWeight="Normal" Foreground="{DynamicResource ThemeText}" Background="Transparent" Width="40" Padding="2" Margin="0,0,8,0" ToolTip="Settings"/>
                        <TextBlock Text="USB Drive Builder" FontSize="32" FontWeight="Light"/>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleText" Text="Prepare standardized support media safely and consistently" Margin="0,2,0,0" Foreground="{DynamicResource ThemeMuted}" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource ReadyBackground}" BorderBrush="{DynamicResource ReadyBorder}" BorderThickness="1" CornerRadius="22" Height="46" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatus" Text="Ready" Foreground="{DynamicResource ReadyText}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="-" Click="Minimize_Click" FontSize="22" Foreground="{DynamicResource ThemeText}" Background="Transparent" Width="42" Padding="4"/>
                    <Button Content="x" Click="Close_Click" FontSize="18" Foreground="{DynamicResource ThemeText}" Background="Transparent" Width="42" Padding="4"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="42,0,42,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,10"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectDriveTitle" Style="{StaticResource SectionTitle}" Text="1. Select USB Drive" Margin="0,0,0,7"/>
                                <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="Refresh_Click" Padding="12,6" Margin="10,0,0,7" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListBox x:Name="DiskPicker" Grid.Row="1" Height="66" SelectionMode="Multiple" SelectionChanged="DiskPicker_SelectionChanged"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="DriveCard" Background="{DynamicResource DriveCardBackground}" BorderBrush="{DynamicResource DriveCardBorder}" BorderThickness="1" CornerRadius="12" Padding="9,7">
                                                <Border.ToolTip><ToolTip><StackPanel MinWidth="230">
                                                    <TextBlock Text="{Binding DiskTitle}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding FriendlyName}" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding SizeDisplay, StringFormat=Capacity: {0}}"/>
                                                    <TextBlock Text="{Binding SerialNumber, StringFormat=Serial number: {0}}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding UniqueId, StringFormat=Unique ID: {0}}" TextWrapping="Wrap" MaxWidth="420"/>
                                                </StackPanel></ToolTip></Border.ToolTip>
                                                <StackPanel><TextBlock x:Name="DriveTitleText" Text="{Binding DiskTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DriveText}"/><TextBlock x:Name="DriveNameText" Text="{Binding FriendlyName}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DriveText}"/><TextBlock x:Name="DriveSizeText" Text="{Binding SizeDisplay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DriveMutedText}"/></StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="DriveCard" Property="Background" Value="{DynamicResource DriveSelectedBackground}"/><Setter TargetName="DriveCard" Property="BorderBrush" Value="{DynamicResource DriveSelectedBorder}"/><Setter TargetName="DriveCard" Property="BorderThickness" Value="2"/></Trigger>
                                                <DataTrigger Binding="{Binding QueueState}" Value="{x:Static local:QueueDriveProgressState.Active}"><Setter TargetName="DriveCard" Property="Background" Value="{DynamicResource DriveActiveBackground}"/><Setter TargetName="DriveCard" Property="BorderBrush" Value="{DynamicResource DriveSelectedBorder}"/><Setter TargetName="DriveCard" Property="BorderThickness" Value="2"/><Setter TargetName="DriveTitleText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveNameText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveSizeText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding QueueState}" Value="{x:Static local:QueueDriveProgressState.Completed}"><Setter TargetName="DriveCard" Property="Background" Value="{DynamicResource DriveCompletedBackground}"/><Setter TargetName="DriveCard" Property="BorderBrush" Value="{DynamicResource DriveSelectedBorder}"/><Setter TargetName="DriveCard" Property="BorderThickness" Value="2"/><Setter TargetName="DriveTitleText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveNameText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveSizeText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding QueueState}" Value="{x:Static local:QueueDriveProgressState.Failed}"><Setter TargetName="DriveCard" Property="Background" Value="{DynamicResource DriveFailedBackground}"/><Setter TargetName="DriveCard" Property="BorderBrush" Value="{DynamicResource DriveFailedBorder}"/><Setter TargetName="DriveCard" Property="BorderThickness" Value="2"/><Setter TargetName="DriveTitleText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveNameText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/><Setter TargetName="DriveSizeText" Property="TextBlock.Foreground" Value="{DynamicResource DriveProgressText}"/></DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DriveCard" Property="BorderBrush" Value="{DynamicResource DriveHoverBorder}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Setter.Value></Setter>
                                    </Style></ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid></Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,13" Margin="0,0,0,10"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="PartitionEditorTitle" Style="{StaticResource SectionTitle}" Text="Partition Settings" Margin="0,0,0,2"/>
                                    <TextBlock Text="Use Add for files, folders, XML, Windows ISO media, drivers, and Setup scripts." Style="{StaticResource Caption}" Margin="2,0,0,7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="AddPartitionButton" Style="{StaticResource CircleButton}" Content="+" Click="AddPartition_Click" Width="32" Height="32" Padding="0" FontSize="18" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" Margin="0,0,6,0" ToolTip="Add a partition"/>
                                    <Button x:Name="MainDefaultsButton" Content="Defaults" Click="MainDefaults_Click" Height="28" Padding="10,3" FontSize="12" ToolTip="Restore the default partitions configured in Settings"/>
                                </StackPanel>
                            </Grid>
                            <ListBox x:Name="MainPartitionList" Grid.Row="1" MaxHeight="250" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Auto" AllowDrop="True" PreviewMouseMove="MainPartitionList_PreviewMouseMove" PreviewMouseLeftButtonUp="MainPartitionList_PreviewMouseLeftButtonUp" DragOver="MainPartitionList_DragOver" DragLeave="MainPartitionList_DragLeave" Drop="MainPartitionList_Drop">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource CircleButton}" Content="−" Click="RemovePartition_Click" Width="28" Height="28" Padding="0" FontSize="18" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" ToolTip="Remove this partition" VerticalAlignment="Center"/>
                                    <Border x:Name="PartitionRowCard" Grid.Column="1" Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeStroke}" BorderThickness="1" CornerRadius="12" Padding="10,7">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="92"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource ThemeSelection}" VerticalAlignment="Center"><TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" Margin="5,0,8,0"><TextBlock Text="Volume label" Style="{StaticResource Caption}" Margin="2,0,0,3"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Height="32" Padding="8,3" TextChanged="PartitionField_TextChanged"/></StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock Text="Size (MB, GB, or *)" Style="{StaticResource Caption}" Margin="2,0,0,3" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SizeField}" Height="32" Padding="8,3" TextChanged="PartitionField_TextChanged"/></StackPanel>
                                        <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock Text="Format" Style="{StaticResource Caption}" Margin="2,0,0,3"/><ComboBox ItemsSource="{x:Static local:PartitionConfig.AllowedFormats}" SelectedItem="{Binding FileSystem, UpdateSourceTrigger=PropertyChanged}" Height="32" Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeStroke}" SelectionChanged="PartitionFormat_SelectionChanged"/></StackPanel>
                                        <Grid Grid.Column="4" VerticalAlignment="Center" ToolTip="{Binding SourcesToolTip}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Button Content="Add" Click="PartitionContentAdd_Click" Width="58" Height="27" Padding="8,3" Margin="0,0,0,4" Background="{DynamicResource AddButtonBackground}" Foreground="{DynamicResource AddButtonForeground}" ToolTip="Add files, folders, XML, ISO, drivers, or Windows Setup scripts"/>
                                                <Button Content="Clear" Click="PartitionSourcesClear_Click" Width="58" Height="27" Padding="8,3" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" ToolTip="Clear all selected content for this partition"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AddedContentSummary}" Foreground="{DynamicResource DriveSelectedBorder}"
                                                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        </Grid>
                                    </Grid></Border>
                                    <Border Grid.Column="2" Background="Transparent" Width="26" Height="34" Padding="4" Cursor="SizeNS" ToolTip="Drag to reorder" MouseLeftButtonDown="PartitionDragHandle_MouseLeftButtonDown"><StackPanel VerticalAlignment="Center"><Rectangle Width="14" Height="2" RadiusX="1" Fill="{DynamicResource ThemeMuted}" Margin="0,0,0,4"/><Rectangle Width="14" Height="2" RadiusX="1" Fill="{DynamicResource ThemeMuted}"/></StackPanel></Border>
                                </Grid>
                                    <DataTemplate.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="PartitionRowCard" Property="BorderBrush" Value="{DynamicResource DriveHoverBorder}"/><Setter TargetName="PartitionRowCard" Property="BorderThickness" Value="2"/></DataTrigger><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="PartitionRowCard" Property="BorderBrush" Value="{DynamicResource DriveSelectedBorder}"/><Setter TargetName="PartitionRowCard" Property="BorderThickness" Value="2"/></DataTrigger></DataTemplate.Triggers>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid></Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,12" Margin="0"><Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="PartitionLayoutTitle" Style="{StaticResource SectionTitle}" Text="Partition Layout" Margin="0,0,0,5"/>
                            <Grid x:Name="PartitionPreview" Grid.Row="1" Margin="0,1" MinHeight="62"/>
                            <TextBlock x:Name="NoDriveSelectedText" Grid.Row="1" Text="NO DRIVE SELECTED" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="PartitionLayoutNote" Grid.Row="2" Text="Each selected disk will use an MBR partition table and UEFI-only Windows boot media." Style="{StaticResource Caption}" Margin="2,3,0,0"/>
                        </Grid></Border>
                </Grid>

                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14"><Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock x:Name="ActivityTitle" Style="{StaticResource SectionTitle}" Text="Activity"/>
                        <ListBox x:Name="ActivityList" Grid.Row="1" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource ThemeMuted}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <ProgressBar x:Name="BuildProgress" Height="8" Foreground="#20B86A" Background="#D9E2DF" Minimum="0" Maximum="100" Value="0" ValueChanged="BuildProgress_ValueChanged"/>
                            <Grid x:Name="QueueProgressSegments" Height="8" Margin="0,8,0,0" ToolTip="USB build queue progress"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,6,0,0">
                            <TextBlock x:Name="CurrentEtaText" Text="Current activity: Waiting" Foreground="{DynamicResource ThemeMuted}" FontSize="11"/>
                            <TextBlock x:Name="QueueEtaText" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid></Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0"><StackPanel>
                        <Border Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,14"><TextBlock x:Name="WarningText" Text="WARNING: Every partition and file on the selected USB drives will be permanently erased." Foreground="{DynamicResource WarningText}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/></Border>
                        <TextBlock x:Name="ConfirmLabel" Text="Type ERASE to confirm" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBox x:Name="ConfirmText" Style="{StaticResource Field}" CharacterCasing="Upper" TextChanged="ConfirmText_TextChanged" Margin="0,0,0,12"/>
                        <Button x:Name="BuildButton" Content="Build USB Queue" Click="Build_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" Height="50" FontSize="16" IsEnabled="False"/>
                        <Button x:Name="CancelBuildButton" Content="Cancel build" Click="CancelBuild_Click" Background="{DynamicResource ClearButtonBackground}" Foreground="{DynamicResource ClearButtonForeground}" Height="38" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel></Border>
                </Grid>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="FooterText" Text="Administrator mode  |  Waiting for a USB drive" Foreground="{DynamicResource ThemeMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
